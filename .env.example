# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
#
# Вариант 1 — OpenAI-совместимый endpoint: Ollama, vLLM или Inference API организаторов.
# Только модели с открытыми весами (Apache 2.0 / MIT, до 35B) — так требует ТЗ.
SD_LLM_PROVIDER=openai_compatible
SD_LLM_BASE_URL=https://api.example.com/v1
SD_LLM_API_KEY=
SD_LLM_MODEL=
SD_LLM_TIMEOUT=180

# Бюджет времени на модель в одной сборке, секунд. ТЗ отводит на колоду пять
# минут; остальное — сборка, рендер и проверки. По исчерпании бюджета сборка
# продолжается без модели.
SD_LLM_BUDGET_S=150

# Вариант 2 — офлайн: без сети, планирование на эвристиках.
# SD_LLM_PROVIDER=stub
