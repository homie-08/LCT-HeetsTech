# Что не попадает в репозиторий и почему.
#
# Правило простое: в git лежит то, что нельзя воспроизвести командой, —
# код, документы, промпты, материалы организаторов и готовые артефакты
# сдачи. Всё, что сервис пересоберёт сам, остаётся локальным.

# --- окружения и кеши ---------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
dist/
.vite/
*.tsbuildinfo
.cache/

# --- секреты -------------------------------------------------------------
# Настройки модели у каждого свои; шаблон лежит в .env.example.
.env
.env.local
*.key

# --- ОС и редакторы ------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
.claude/settings.local.json

# --- производное от шаблонов ---------------------------------------------
# Заготовки Office и темы берутся с машины пользователя:
# `python templates/fetch_local.py` и `templates/from_themes.py`.
templates/deck/
templates/theme/

# --- рабочие каталоги сервиса ---------------------------------------------
# Задания API (разобранные шаблоны, собранные колоды, снимки слайдов),
# обложки библиотеки, разбор шаблонов и контрольные листы — всё это сервис
# создаёт заново при первом запуске.
data/api/
data/covers/
data/design/
data/previews/

# --- сборки и черновики в data/out ----------------------------------------
# По умолчанию не кладём ничего, а ниже перечисляем то, что нужно для сдачи.
data/out/*
!data/out/vk9/
!data/out/видео/
!data/out/pitch/

# Девять колод для сдачи: сами файлы нужны, рабочие каталоги рядом — нет.
data/out/vk9/*.log
data/out/vk9/summary.txt
data/out/vk9/**/qa/
data/out/vk9/**/slides/

# Видео: в репозитории — готовые mp4, исходные записи Playwright не нужны.
data/out/видео/*.webm

# Питч: файлы презентации и картинки для неё; рендеры страниц — производные.
data/out/pitch/render/

# --- материалы организаторов ----------------------------------------------
# Распакованное лежит в репозитории, архивы — те же байты ещё раз.
ресурсы/*.zip

# Шаблоны, загруженные через интерфейс: рабочая папка сервиса, копии
# лежащих рядом файлов.
templates/user/
